-document.addEventListener('visibilitychange', () => { if (AC) document.hidden ? AC.suspend() : AC.resume(); });
+document.addEventListener('visibilitychange', () => {
+  if (!AC) return;
+  if (document.hidden) {
+    // fade out before suspending, so locking the screen does not click
+    if (OUT) OUT.gain.setTargetAtTime(0, AC.currentTime, 0.02);
+    setTimeout(() => { if (document.hidden) AC.suspend().catch(() => 0); }, 60);
+  } else {
+    AC.resume().catch(() => 0);
+    if (OUT) OUT.gain.setTargetAtTime(muted ? 0 : VOL, AC.currentTime, 0.05);
+  }
+});
